# Application Settings
APP_NAME="AI-Based Projectile Motion Prediction API"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

