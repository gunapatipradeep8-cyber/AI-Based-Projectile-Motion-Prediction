# Application Settings
APP_NAME="AI-Based Projectile Motion Prediction API"
ENVIRONMENT="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (comma-separated list of frontend domains)
# Add your Vercel deployment domain here, e.g. https://your-app.vercel.app
FRONTEND_URL="https://*.vercel.app"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app"

# Model File Configuration
MODEL_PATH="app/models/projectile_model.pkl"

# Google Gemini API Key and Model for Live AI Physics Assistant & General Tutor
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"
